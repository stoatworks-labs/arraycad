{
  "name": "arraycad",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Convert CAD venue models into d&b ArrayCalc venue files \u2014 import, prune, assign plane types, export .dbacv.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4321",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-projects/acad-ts": "^3.0.2",
    "@types/earcut": "^3.0.0",
    "delaunator": "^5.1.0",
    "dxf-parser": "^1.1.2",
    "earcut": "^3.2.3",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
