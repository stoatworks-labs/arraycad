{
  "name": "ArrayCAD",
  "short_name": "ArrayCAD",
  "description": "Convert CAD venue models into d&b ArrayCalc venue files. Import, prune, assign plane types, export .dbacv.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a1420",
  "theme_color": "#0a1420",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
