/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: https://intake.stoatworks-labs.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The worker is the one file that must never be served stale: a cached sw.js
# is a cached update mechanism, and the app would stop being able to replace
# itself. Build output it caches is content-hashed and immutable above, and
# everything else it holds is only a fallback for when there is no network, so
# nothing is lost by revalidating this one small file every time.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
